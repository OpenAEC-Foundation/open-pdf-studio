# Copy to .env, restrict access, and configure an existing private S3 bucket.
OPDS_S3_BUCKET=replace-with-private-bucket
OPDS_S3_REGION=us-east-1
OPDS_S3_ENDPOINT=https://replace-with-s3-endpoint
AWS_ACCESS_KEY_ID=replace-with-scoped-access-key
AWS_SECRET_ACCESS_KEY=replace-with-scoped-secret
# Optional for temporary credentials:
# AWS_SESSION_TOKEN=
OPDS_THREADS=16
OPDS_MAX_WAITERS=8
