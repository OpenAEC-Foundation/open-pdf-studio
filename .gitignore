# Dependencies
node_modules/

# Build output
dist/
dist-web-unit/
out/

# Rust / Cargo build output — elke target-map op elk niveau
# (root workspace, open-pdf-render, src-tauri) plus losse iteratie-varianten
target/
target-*/

# pdfium-worker-sidecar: build-artefact dat build.rs/CI zelf plaatsen
binaries/pdfium-worker-*

# macOS in-proc PDFium: door CI opgehaald (SHA-256-geverifieerd), niet gecommit
binaries/macos-universal/

# OCR runtime assets (Tesseract trained-data + CJK font): opgehaald door
# scripts/ocr-runtime.mjs (SHA-256-geverifieerd), niet gecommit.
open-pdf-studio/src-tauri/resources/tessdata/
open-pdf-studio/src-tauri/resources/fonts/

