# Copy to deploy/.env and fill in. Never commit the filled-in file.

# ── Required ───────────────────────────────────────────────────────────────
# Bearer token the agent presents on /mcp/<code>. The relay refuses to start
# without it. Anyone holding this AND a live session code can drive the
# document, so treat it as a password. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
OPS_RELAY_SECRET=

# ── Optional ───────────────────────────────────────────────────────────────
# Host port for the app. Put TLS in front of this rather than exposing it
# directly — session codes and the bearer token travel over it.
OPS_WEB_PORT=8080

# The origin the browser loads the app from. With the bundled proxy the app
# and the relay share an origin, so this is only a defence-in-depth setting;
# set it to your real public URL in production.
OPS_RELAY_ORIGIN=http://localhost:8080
