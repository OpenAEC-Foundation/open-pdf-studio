# mcp-relay — forwards MCP tool calls from an agent to a browser tab.
#
# Deliberately small: the relay is a transport, and the only dependency is
# `ws`. Node 22 for the built-in fetch and WebSocket client used by --probe.

FROM node:22-alpine

WORKDIR /app

# Install dependencies first so a code change does not re-run npm ci.
COPY mcp-relay/package.json mcp-relay/package-lock.json* ./
RUN npm ci --omit=dev 2>/dev/null || npm install --omit=dev

COPY mcp-relay/ ./

# The journal is the recovery path for an agent's work after a lost tab, so it
# has to outlive the container. Mount a volume here.
ENV OPS_RELAY_JOURNAL=/data/journal
RUN mkdir -p /data/journal && chown -R node:node /data

# Bind all interfaces INSIDE the container — the reverse proxy in front is
# what actually faces the network. Never publish this port directly.
ENV OPS_RELAY_HOST=0.0.0.0
ENV OPS_RELAY_PORT=9224

USER node
EXPOSE 9224

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:9224/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.mjs"]
