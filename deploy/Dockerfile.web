# The Open PDF Studio web build, plus the reverse proxy that puts it on the
# same origin as the relay.
#
# Same origin is the point: the page, /session, /mcp/<code> and /ws all answer
# on one host, so there is no CORS to configure and one certificate to manage.

# ── Build ──────────────────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /src

COPY open-pdf-studio/package.json open-pdf-studio/package-lock.json ./
# The full dependency set is needed — vite and the solid plugin are devDeps.
RUN npm ci

COPY open-pdf-studio/ ./

# Relative, so this image runs on any hostname without a rebuild. The browser
# resolves it against whatever origin served the page (see resolveRelayUrls
# in js/mcp-transport.js).
ENV VITE_OPS_RELAY_URL=/ws
RUN npx vite build

# ── Serve ──────────────────────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
